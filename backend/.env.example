# Copy to .env — everything is OPTIONAL in dev (simulated when missing)

PORT=5055
JWT_SECRET=change-me-in-production

# Twilio (SMS) — leave empty in dev, messages log to console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Square (deposits) — leave empty in dev, holds are simulated.
# From developer.squareup.com → your app. Register OAuth redirect URL:
#   {BACKEND_PUBLIC_URL}/api/square/callback
SQUARE_APP_ID=
SQUARE_APP_SECRET=
SQUARE_ENV=sandbox

# Frontend origin for CORS + links in SMS
FRONTEND_URL=http://localhost:3001
# Public URL of THIS backend (for the Square OAuth redirect + LS webhook)
BACKEND_PUBLIC_URL=http://localhost:5055

# Lemon Squeezy (how salons pay ShowSure) — leave empty in dev to simulate upgrades
LEMONSQUEEZY_API_KEY=
LS_STORE_ID=
LS_VARIANT_STARTER=
LS_VARIANT_PRO=
LS_VARIANT_GROWTH=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Admin secret for curating the public salon directory (x-admin-secret header)
ADMIN_SECRET=generate-a-long-random-string
