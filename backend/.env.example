# Copy to .env — everything is OPTIONAL in dev (simulated when missing)

PORT=5055
JWT_SECRET=change-me-in-production

# Twilio (SMS) — leave empty in dev, messages log to console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# For "Reply YES to claim it": in the Twilio console, set this number's inbound
# SMS webhook to {BACKEND_PUBLIC_URL}/api/sms/inbound (HTTP POST). Signature
# validation needs the EXACT public URL below — must match the Twilio config.
SMS_WEBHOOK_URL=

# Text-based AI concierge — replies to free-text SMS questions ("what time do
# you close Saturday?") grounded in the salon's own hours/services. Leave
# empty and the feature just stays silent (no crash, no reply). Get a key at
# console.anthropic.com.
ANTHROPIC_API_KEY=

# Square (deposits) — leave empty in dev, holds are simulated.
# From developer.squareup.com → your app. Register OAuth redirect URL:
#   {BACKEND_PUBLIC_URL}/api/square/callback
SQUARE_APP_ID=
SQUARE_APP_SECRET=
SQUARE_ENV=sandbox

# Frontend origin for CORS + links in SMS
FRONTEND_URL=http://localhost:3001
# Public URL of THIS backend (for the Square OAuth redirect + LS webhook)
BACKEND_PUBLIC_URL=http://localhost:5055

# Lemon Squeezy (how salons pay ShowSure) — leave empty in dev to simulate upgrades
LEMONSQUEEZY_API_KEY=
LS_STORE_ID=
LS_VARIANT_STARTER=
LS_VARIANT_PRO=
LS_VARIANT_GROWTH=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Admin secret for curating the public salon directory (x-admin-secret header)
ADMIN_SECRET=generate-a-long-random-string
